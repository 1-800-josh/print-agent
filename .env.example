# API Configuration
API_BASE_URL=http://localhost:3000
API_KEY=your-service-api-key-here
ORGANISATION_ID=your-organisation-uuid
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Sync Configuration
SYNC_INTERVAL_SECONDS=60
MAX_WORKERS=10
NETWORK_DRIVE_PREFIX=/Users/example/print-agent/

# Optional: Custom paths (defaults to platform-appropriate directories)
# OUTPUT_BASE_DIR=/var/lib/printagent/output
# LOG_DIR=/var/lib/printagent/logs
# RENAME_LOG_DIR=/var/lib/printagent/logs/renames
# MOVEMENT_LOG_DIR=/var/lib/printagent/logs/movements
# HOT_FOLDERS_BASE=/var/lib/printagent/hotfolders
# NETWORK_DRIVE_PREFIX=//server/share

# Service Configuration
SERVICE_NAME=PrintAgentSync
