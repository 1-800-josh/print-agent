# API Configuration
API_BASE_URL=http://localhost:3000
API_KEY=your-service-api-key-here
ORGANISATION_ID=your-organisation-uuid
UPLOADTHING_APP_ID=your-uploadthing-app-id

# Sync Configuration
SYNC_INTERVAL_SECONDS=60
MAX_WORKERS=10
DOWNLOAD_TIMEOUT_SECONDS=60
CONFIG_REFRESH_INTERVAL_SECONDS=300

# File Watcher Configuration
FILE_EVENT_DEBOUNCE_SECONDS=2.0
FILE_CLEANUP_INTERVAL_SECONDS=30

# Reconciliation (default: true)
RECONCILE_TASK_STATES=true
CLEANUP_EMPTY_ARTWORK_FOLDERS=true

# Path Configuration
NETWORK_DRIVE_PREFIX=/Users/example/print-agent/
ARTWORK_FOLDER=artworks
USERS_FOLDER=users

# Optional: Custom paths (defaults to platform-appropriate directories)
OUTPUT_BASE_DIR=/var/lib/printagent/output # Optional
LOG_DIR=/var/lib/printagent/logs # Optional
RENAME_LOG_DIR=/var/lib/printagent/logs/renames # Optional
MOVEMENT_LOG_DIR=/var/lib/printagent/logs/movements # Optional
HOT_FOLDERS_BASE=/var/lib/printagent/hotfolders # Optional

# Service Configuration
SERVICE_NAME=PrintAgentSync
